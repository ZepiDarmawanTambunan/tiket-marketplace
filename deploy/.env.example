# Contoh environment untuk docker compose — salin ke `.env` lalu isi.
# JANGAN commit file `.env` yang sudah diisi ke git.
#
# Mode laptop (testing + Cloudflare Tunnel):
#   docker compose -f docker-compose.yml -f docker-compose.laptop.yml up --build -d mysql api web
# Mode VPS/produksi: lihat PANDUAN_PRODUKSI.md (pakai DOMAIN + caddy).

# --- Database ---
DB_NAME=tiket_db
DB_USER=tiket
DB_PASSWORD=ganti-dengan-password-acak-yang-kuat

# --- Backend API ---
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL=86400
SETTINGS_MASTER_KEY=ganti-dengan-master-key-acak-minimal-32-karakter
QR_SECRET=ganti-dengan-string-acak-minimal-32-karakter
SEED_ADMIN_PASSWORD=admin123
# Catatan: password default admin@tiket.local — WAJIB diganti setelah login pertama.

# --- Kunci Midtrans ---
# Biarkan DUMMY; isi kunci sandbox ASLI via panel admin → Pengaturan → Midtrans
# (tersimpan terenkripsi di database, bukan di file ini).
MIDTRANS_SERVER_KEY=DUMMY-SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=DUMMY-SB-Mid-client-xxxxxxxxxxxxxxxx

# --- Wajib ada agar docker-compose.yml ter-parse ---
# Di mode laptop nilainya tidak dipakai (service caddy tidak dijalankan).
DOMAIN=localhost

# --- Mode laptop saja (dibaca oleh docker-compose.laptop.yml) ---
# Asal frontend yang diizinkan API (untuk akses lokal).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# URL API yang dipakai frontend. Di-bake saat image web di-build,
# jadi isi SEBELUM `up --build` pertama; kalau diubah, build ulang:
#   docker compose -f docker-compose.yml -f docker-compose.laptop.yml build web
NEXT_PUBLIC_API_URL=http://localhost:8080
