# Contoh konfigurasi environment — salin ke .env lalu isi nilai aslinya.
# JANGAN commit file .env yang sudah diisi ke git.

# Port HTTP API
PORT=8080

# DSN MySQL (format: user:password@tcp(host:port)/dbname?parseTime=true)
DB_DSN=tiket:tiket@tcp(127.0.0.1:3306)/tiket_db?parseTime=true

# Secret untuk menandatangani JWT (wajib, acak & panjang di production)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Masa berlaku token JWT dalam detik (default 86400 = 24 jam)
JWT_ACCESS_TTL=86400

# Master key untuk enkripsi AES-256-GCM pada settings sensitif (server_key dkk).
# Wajib diisi; bila diganti, settings terenkripsi lama tidak bisa dibaca lagi.
SETTINGS_MASTER_KEY=ganti-dengan-master-key-acak-minimal-32-karakter

# Secret HMAC-SHA256 untuk qr_payload tiket (wajib, acak & panjang)
QR_SECRET=ganti-dengan-qr-secret-acak-minimal-32-karakter

# Password awal super admin (admin@tiket.local). Default "admin123" bila kosong —
# WAJIB diganti setelah login pertama.
SEED_ADMIN_PASSWORD=admin123

# --- Midtrans (dibaca oleh `go run ./cmd/seed`; setelah itu kelola via panel admin) ---
# Di development biarkan DUMMY agar order tetap bisa dibuat tanpa key asli.
MIDTRANS_SERVER_KEY=DUMMY-SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=DUMMY-SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=DUMMY-MERCHANT
MIDTRANS_ENVIRONMENT=sandbox

# Origin frontend yang diizinkan (koma-dipisah). Default: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
