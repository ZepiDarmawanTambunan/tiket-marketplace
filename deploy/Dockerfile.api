# syntax=docker/dockerfile:1
# Build Go backend (api + migrate + seed) — multi-stage, image ramping akhir kecil.
FROM golang:1.23-bookworm AS builder
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api && \
    CGO_ENABLED=0 go build -o /out/migrate ./cmd/migrate && \
    CGO_ENABLED=0 go build -o /out/seed ./cmd/seed

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /out/api /out/migrate /out/seed /app/
EXPOSE 8080
# Default menjalankan API; migrate/seed dipanggil via `docker compose exec`.
CMD ["/app/api"]
