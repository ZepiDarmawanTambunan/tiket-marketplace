# Salin ke .env.production lalu isi nilai aslinya.
# JANGAN commit file .env.production yang sudah diisi ke git.

# Domain publik (tanpa https://), mis. tiketkita.id
DOMAIN=

# Database (buat password acak yang kuat)
DB_NAME=tiket_db
DB_USER=tiket
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Secrets backend — hasilkan acak, min 32 karakter, dan JANGAN diganti setelah seed
# pertama (kalau diganti, isi ulang Midtrans keys via panel admin).
JWT_SECRET=
JWT_ACCESS_TTL=86400
SETTINGS_MASTER_KEY=
QR_SECRET=

# Password awal super admin — dipakai sekali saat seed; ganti via panel admin
# segera setelah login pertama.
SEED_ADMIN_PASSWORD=

# Midtrans — isi SANDBOX dulu untuk uji, ganti ke PRODUCTION keys saat go-live
# via panel admin (lebih aman, terenkripsi di DB).
MIDTRANS_SERVER_KEY=DUMMY-SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=DUMMY-SB-Mid-client-xxxxxxxxxxxxxxxx
